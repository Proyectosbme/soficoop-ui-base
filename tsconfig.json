{
  "compileOnSave": false,
  "compilerOptions": {
    /* Output */
    "outDir": "./dist/out-tsc",

    /* Language and Environment */
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],

    /* Strictness */
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* Build Performance */
    "skipLibCheck": true,
    "isolatedModules": true,
    "importHelpers": true,

    /* Interop */
    "esModuleInterop": true,
    "experimentalDecorators": true,

    /* 🔑 BASE PATHS */
    "baseUrl": "src",

    /* 🔑 ARCHITECTURE ALIASES */
    "paths": {
      "@core/*": ["app/core/*"],
      "@security/*": ["app/features/security/*"],
      "app/security/*": ["app/features/security/*"],
      "@security/components/*": ["app/features/security/components/*"],
      "@security/pages/*": ["app/features/security/pages/*"],
      "@security/routes/*": ["app/features/security/routes/*"],
      "@security/services/*": ["app/features/security/services/*"],
      "@security/models/*": ["app/features/security/models/*"],
      "@security/api/*": ["app/features/security/api/*"],
      "@security/dto/*": ["app/features/security/dto/*"],
      "@general/*": ["app/general/*"],
      "@shared/*": ["app/shared/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
